## 💻 代码风格

### TypeScript/JavaScript

```typescript
// 缩进：2空格
// 引号：单引号
// 分号：有分号
// 行宽：≤ 120字符

interface Container {
  id: string;
  number: string;
  status: ContainerStatus;
}

function processContainer(container: Container): void {
  validate(container);
  update(container);
}
```

### Vue SFC

```vue
<script setup lang="ts">
// 缩进：2空格
// 引号：单引号
// 分号：无分号
// 行宽：≤ 100字符

import { ref } from 'vue'

const count = ref(0)

function increment() {
  count.value++
}
</script>

<template>
  <button @click="increment">{{ count }}</button>
</template>

<style scoped lang="scss">
button {
  color: $primary-color;
}
</style>
```

