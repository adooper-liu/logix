#!/usr/bin/env sh
. "$(dirname "$0")/h"

echo "========================================="
echo "🔍 LogiX 代码质量检查"
echo "========================================="
echo ""

# Step 1: TypeScript 类型检查
echo "Step 1/3: TypeScript 类型检查..."
npm run type-check
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ TypeScript 类型检查失败！请修复类型错误后再提交。"
  exit 1
fi
echo "✅ TypeScript 类型检查通过"
echo ""

# Step 2: ESLint 代码风格检查
echo "Step 2/3: ESLint 代码风格检查..."
npm run lint
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ ESLint 检查失败！请修复代码风格问题后再提交。"
  echo "💡 提示：运行 'npm run lint:fix' 自动修复部分问题"
  exit 1
fi
echo "✅ ESLint 检查通过"
echo ""

# Step 3: 命名规范检查
echo "Step 3/3: 命名规范检查..."
npm run lint:naming
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ 命名规范检查失败！请修复命名问题后再提交。"
  exit 1
fi
echo "✅ 命名规范检查通过"
echo ""

echo "========================================="
echo "✅ 所有检查通过！允许提交。"
echo "========================================="
